// En Prisma 7+ la URL de conexión va en prisma.config.ts, no aquí.
// El datasource solo necesita el provider.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  recoveryCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Template {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  imageUrl     String
  maxPositions Int
  positions    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Raffles      Raffle[]
}

model Raffle {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  rangeStart       Int
  rangeEnd         Int
  digits           Int
  numbersPerTicket Int
  templateId       String   @db.Uuid
  template         Template @relation(fields: [templateId], references: [id])
  status           String   @default("PENDING")
  pdfUrl           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
